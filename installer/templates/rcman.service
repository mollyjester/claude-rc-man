# Written by install.sh.
[Unit]
Description=rcman
After=network-online.target
Wants=network-online.target

[Service]
User=rcman
Group=rcman
WorkingDirectory=@CURRENT@
EnvironmentFile=@ETC@/rcman.env
# No NoNewPrivileges: rcman runs rc-helper and rc-admin through sudo.
# Its only listener is the unix socket @SOCKET@, in a directory only Caddy's group
# may enter, made at boot by /etc/tmpfiles.d/rcman.conf.
ExecStart=@CURRENT@/.venv/bin/uvicorn --factory rcman.main:create_app --uds @SOCKET@
Restart=on-failure

[Install]
WantedBy=multi-user.target
