# Written by install.sh.
[Unit]
Description=rcman
After=network-online.target
Wants=network-online.target

[Service]
User=rcman
Group=rcman
WorkingDirectory=@CURRENT@
EnvironmentFile=@ETC@/rcman.env
# No NoNewPrivileges: rcman runs rc-helper and rc-admin through sudo.
ExecStart=@CURRENT@/.venv/bin/uvicorn --factory rcman.main:create_app --host 127.0.0.1 --port @APP_PORT@
Restart=on-failure

[Install]
WantedBy=multi-user.target
