# rcman's settings, written by install.sh. See docs/configuration.md.
RCMAN_PUBLIC_ORIGIN=https://@DOMAIN@
RCMAN_DATABASE=@STATE@/rcman.db
RCMAN_ALLOWED_EMAILS=@STATE@/allowed-emails
RCMAN_WORKSPACE_IMAGE=@WORKSPACE_IMAGE@
RCMAN_BUILDER_IMAGE=@BUILDER_IMAGE@
RCMAN_TOOLS_DIR=@TOOLS@
RCMAN_CLAUDE_STORE=@CLAUDE_STORE@
RCMAN_DOCS_DIR=@CURRENT@/docs
RCMAN_FRONTEND_DIR=@CURRENT@/frontend/dist
