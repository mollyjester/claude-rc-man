# The system the container suites run rcman's installer in, on the tests' own engine
# (tests/podman_service.py), and the worktree checks of tests/test_container_suite.py: Ubuntu as
# the installer is tested on, with what the installer installs or needs already (Caddy among
# them), so that it installs no package (installer/install.py PACKAGES). The recorded stand-ins
# of tests/container/stand_ins.py are mounted over systemctl, loginctl and rcman's podman at run
# time, by tests/container/test_install_in_container.py.
FROM docker.io/library/ubuntu:26.04@sha256:065aa8626841f16057b78b027b464cd59c4fac36c204c72dcbf48d66f5fa8a96
RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      podman crun uidmap catatonit passt dbus-user-session busybox-static ncurses-base \
      python3 git caddy curl ca-certificates xz-utils procps \
 && rm -rf /var/lib/apt/lists/*
