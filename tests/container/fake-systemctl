#!/usr/bin/python3
"""Stands in for systemctl in the test container, which has no systemd.

It reads the real unit files the installer wrote and starts each service the
way its unit says: as its User=, in its WorkingDirectory=, with only the
variables of its EnvironmentFile=, running its ExecStart=. Supports
daemon-reload, enable, start, stop, restart and is-active.
"""

import os
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path

UNITS = Path("/etc/systemd/system")
STATE = Path("/run/fake-systemd")


def unit(name):
    fields = {}
    for line in (UNITS / name).read_text().splitlines():
        if "=" in line and not line.startswith("#"):
            key, _, value = line.partition("=")
            fields[key.strip()] = value.strip()
    return fields


def pid_of(name):
    try:
        pid = int((STATE / f"{name}.pid").read_text())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def stop(name):
    pid = pid_of(name)
    if pid:
        os.killpg(pid, signal.SIGTERM)
        for _ in range(50):
            if pid_of(name) is None:
                break
            time.sleep(0.1)


def start(name):
    if pid_of(name):
        return
    u = unit(name)
    env = {}
    if "EnvironmentFile" in u:
        for line in Path(u["EnvironmentFile"]).read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                key, _, value = line.partition("=")
                env[key] = value
    env.setdefault("PATH", "/usr/local/bin:/usr/bin:/bin")
    argv = ["runuser", "-u", u["User"], "--", "/usr/bin/env", "-i", *(f"{k}={v}" for k, v in env.items())]
    argv += shlex.split(u["ExecStart"])
    STATE.mkdir(exist_ok=True)
    log = open(STATE / f"{name}.log", "ab")
    proc = subprocess.Popen(argv, cwd=u.get("WorkingDirectory", "/"), stdout=log, stderr=log, start_new_session=True)
    (STATE / f"{name}.pid").write_text(str(proc.pid))


def main(args):
    quiet = "--quiet" in args
    args = [a for a in args if not a.startswith("--")]
    command, names = args[0], args[1:]
    if command in ("daemon-reload", "enable"):
        return 0
    for name in names:
        if command == "start":
            start(name)
        elif command == "stop":
            stop(name)
        elif command == "restart":
            stop(name)
            start(name)
        elif command == "is-active":
            active = pid_of(name) is not None
            if not quiet:
                print("active" if active else "inactive")
            if not active:
                return 3
    return 0


sys.exit(main(sys.argv[1:]))
