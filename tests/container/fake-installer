#!/bin/sh
# Stands in for the Claude Code installer: installs the fake claude, reporting
# the version it was asked for, into the user's ~/.local/bin, and records the
# version. Version 0.0.1 installs a broken binary instead, which every upgrade
# check must reject, and which prints a sign-in URL that no report may carry.
# Version 0.0.2 fails to install: it prints more lines than a report keeps, an
# email address that no report may carry, and a last line to recognise.
set -e
mkdir -p "$HOME/.local/bin"
if [ "$1" = "0.0.2" ]; then
  i=0
  while [ $i -lt 200 ]; do echo "installer line $i"; i=$((i + 1)); done
  echo "downloading for plant.person@example.org" >&2
  echo "the installer gave up on $1" >&2
  exit 3
fi
if [ "$1" = "0.0.1" ]; then
  printf '#!/bin/sh\necho broken\necho https://claude.com/cai/oauth/authorize?state=PLANTSTATE\n' > "$HOME/.local/bin/claude"
else
  printf '#!/bin/sh\nFAKE_CLAUDE_VERSION=%s exec /src/tests/fakes/claude "$@"\n' "$1" > "$HOME/.local/bin/claude"
fi
chmod 755 "$HOME/.local/bin/claude"
echo "$1" >> "$HOME/.fake-installs"
