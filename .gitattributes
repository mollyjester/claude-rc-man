# Development-only paths. install.sh deploys with `git archive`, which omits
# anything marked export-ignore. The directory form excludes the tree from the
# archive; the /** form marks each file, so `git check-attr` can verify it.
/tests export-ignore
/tests/** export-ignore
/devtools export-ignore
/devtools/** export-ignore
/.claude export-ignore
/.claude/** export-ignore
/.github export-ignore
/.github/** export-ignore
/project-knowledge export-ignore
/project-knowledge/** export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/Makefile export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
