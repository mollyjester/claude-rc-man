# Development-only paths. install.sh deploys with `git archive`, which omits
# anything marked export-ignore. The directory form excludes the tree from the
# archive; the /** form marks each file, so `git check-attr` can verify it.
/tests export-ignore
/tests/** export-ignore
/devtools export-ignore
/devtools/** export-ignore
/.claude export-ignore
/.claude/** export-ignore
/project-knowledge export-ignore
/project-knowledge/** export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/Makefile export-ignore
/.devcontainer export-ignore
/.devcontainer/** export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
# The frontend's sources: a deployment receives the built frontend/dist instead.
/frontend export-ignore
/frontend/** export-ignore
# The installer runs from the clone, not from a release.
/install.sh export-ignore
/installer export-ignore
/installer/** export-ignore
